; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Not My Parcel!"
run/main_scene="res://menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="punkt_vydachi"
boot_splash/image="res://assets/ui/splash.png"
boot_splash/use_filter=false
boot_splash/bg_color=Color( 0.07, 0.05, 0.07, 1 )
config/icon="res://icon.png"

[autoload]

Settings="*res://scripts/settings.gd"
Sfx="*res://scripts/sfx.gd"
Game="*res://scripts/game.gd"
Net="*res://scripts/net.gd"
Ach="*res://scripts/achievements.gd"

[display]

window/size/width=640
window/size/height=360
window/size/test_width=1280
window/size/test_height=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://fonts/main_font.tres"

[locale]

fallback="ru"

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
quality/driver/fallback_to_gles2=true
environment/default_clear_color=Color( 0.05, 0.04, 0.05, 1 )
