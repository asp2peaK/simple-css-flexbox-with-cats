static func pick_tasks(day: int, has_freezer: bool) -> Array:
	var pool := []
	for id in TASKS:
		if TASKS[id][4] > day:
			continue
		if id == "frozen" and not has_freezer:
			continue
		pool.append(id)
	pool.shuffle()
	return pool.slice(0, 1) if pool.size() >= 2 else pool


static func task_done(id: String, stats: Dictionary, served: int) -> bool:
	var t: Array = TASKS[id]
	var n := int(stats.get(t[2], 0))
	if t[3]:
		return n == 0 and served >= 3
	return n >= t[1]


static func task_text(id: String, stats: Dictionary, served: int, done: bool) -> String:
	var t: Array = TASKS[id]
	var mark := "[x] " if done else "[ ] "
	if t[3]:
		return mark + tr_s(t[0])
	return mark + tr_s(t[0]) + " (%d/%d)" % [int(min(t[1], stats.get(t[2], 0))), t[1]]


static func reviews(stats: Dictionary, failed: int, served: int) -> Array:
	var pool := []
	for r in REVIEWS:
		var k: String = r[0]
		if k == "good":
			if failed == 0 and served >= 3:
				pool.append(r)
		elif k == "meh":
			if failed > 0 and failed <= 2:
				pool.append(r)
		elif int(stats.get(k, 0)) > 0:
			pool.append(r)
	pool.shuffle()
	# один отзыв на каждый повод
	var used := {}
	var out := []
	for r in pool:
		if used.has(r[0]):
			continue
		used[r[0]] = true
		out.append(r)
		if out.size() >= 4:
			break
	return out


static func tr_s(s: String) -> String:
	return TranslationServer.translate(s)
